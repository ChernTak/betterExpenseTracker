# Flutter
front-end/.env
front-end/.dart_tool/
front-end/build/
front-end/dart_defines.wifi.json
front-end/dart_defines.usb.json

# Node.js
back-end/.env
back-end/node_modules/
back-end/logs/

# Python
ai/**/__pycache__/
ai/.venv/

# Datasets and trained model artifacts get large fast and are
# regenerable, so only the folder structure (.gitkeep) is tracked.
ai/data/raw/*
!ai/data/raw/.gitkeep
ai/data/processed/*
!ai/data/processed/.gitkeep
ai/models/*
!ai/models/.gitkeep

# Raw PyTorch training checkpoints (500MB+ .safetensors) for the receipt
# NER model — regenerable via ai/receipt_ner/receipt_ner_gpu_training_v3.ipynb
# and far over GitHub's 100MB file limit. Only the converted .tflite in
# ai/models/ (already ignored above) is what the backend actually serves.
ai/saved_pytorch_model*/

# Copy of the trained Tier B model Flutter actually bundles (see
# ai/train_tier_b.py) — same regenerable-artifact reasoning as ai/models/
# above. The Vosk wake-word model zip (FR4.4) is excluded for the same
# "don't commit a large binary" reason, though it's a manual download
# rather than a regenerated one — see front-end/assets/models/README.md,
# which IS tracked so the download step isn't lost.
front-end/assets/models/*
!front-end/assets/models/.gitkeep
!front-end/assets/models/README.md

# Thesis/submission material — not part of the app
chapter5ss/
fyp2-submission/

# UI Automator debug dumps and ad-hoc test screenshots, not app artifacts
/ui_dump*.xml
.test-screenshots/

# General
.DS_Store

# Editor/tooling state — .vscode/settings.json holds a plaintext DB
# password (SQLTools connection config), and .idea/.claude are local
# machine/session state, none of which belong in version control.
.vscode/
.idea/
.claude/

# Empty files with no content — stray files or dead stubs from early
# scaffolding that never got filled in (superseded by code living
# elsewhere in the current folder structure).
PG Local.session.sql
README.md.txt
back-end/src/jobs/mlOutput.model.js
back-end/src/jobs/weekly.forecast.job.js
back-end/src/middleware/error.middleware.js
back-end/src/middleware/validate.middleware.js
back-end/src/ml/anomaly.js
back-end/src/ml/categorizer.js
back-end/src/models/mlOutput.js
