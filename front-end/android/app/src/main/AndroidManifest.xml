<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- vosk_flutter_2's own manifest declares minSdkVersion 30; without
         this override the manifest merger forces this app's whole minSdk up
         to match it (see android/app/build.gradle.kts). WakeWordService
         gates itself off below API 30 at runtime instead. -->
    <uses-sdk tools:overrideLibrary="org.vosk.vosk_flutter" />

    <!-- FR4.2 — receipt photo capture for OCR -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Location-based food recommendation feature -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- High-spend-area geofencing nudge (separate background_location_consent
         opt-in, see profile_screen.dart) — ACCESS_BACKGROUND_LOCATION lets
         GeofenceReceiver fire even when the app isn't running; Android 10+
         requires this as a distinct, second permission request after
         foreground location is already granted. RECEIVE_BOOT_COMPLETED lets
         BootReceiver re-register geofences, which the OS otherwise clears
         on every device reboot. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- FR4.4 — hands-free "Ok App" wake-word listening (WakeWordService)
         and the speech_to_text handoff transcription that follows it. Scoped
         to while the app process is alive (foreground, or briefly
         backgrounded) rather than a full Android foreground service — see
         WakeWordService's doc comment for why. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="expense_tracker"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- High-spend-area geofencing nudge: fires on ENTER even if the app
             process is dead — Play Services starts this receiver directly.
             exported=false since only the OS (via the PendingIntent
             GeofenceManager registers) ever needs to trigger it. -->
        <receiver
            android:name=".GeofenceReceiver"
            android:exported="false" />

        <!-- Re-registers geofences after a reboot clears them. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher (venue detail screen): tap-to-call, tap-to-open-website,
             Get Directions — Android 11+ package visibility requires these
             declared explicitly for canLaunchUrl/launchUrl to resolve reliably. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- speech_to_text (FR4.4 voice expense logging): Android 11+ package
             visibility rules hide RecognitionService-capable components
             (e.g. Google's on-device speech recognizer) from this app unless
             declared here — without it, SpeechToText.initialize() silently
             reports unavailable on affected devices. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
